#!/usr/bin/env bash
#
# Query World ID enrollment status via Unix domain socket.
# 
# Usage: query-worldid-status <telegram_user_id>
# 
# Required environment variables:
#   WORLDID_STATUS_SOCKET - Path to Unix domain socket
#   WORLDID_STATUS_SECRET_FILE - Path to file containing bearer token
#
# Exit codes:
#   0 - Success
#   1 - Invalid arguments
#   2 - Authentication failed
#   3 - Network error or socket unavailable
#   4 - Rate limit exceeded

set -euo pipefail

# Check arguments
if [ $# -ne 1 ]; then
  echo "Usage: query-worldid-status <telegram_user_id>" >&2
  exit 1
fi

USER_ID="$1"

# Validate user ID is numeric
if ! [[ "$USER_ID" =~ ^[0-9]+$ ]]; then
  echo "Error: telegram_user_id must be numeric" >&2
  exit 1
fi

# Check required environment variables
if [ -z "${WORLDID_STATUS_SOCKET:-}" ]; then
  echo "Error: WORLDID_STATUS_SOCKET environment variable not set" >&2
  exit 3
fi

if [ -z "${WORLDID_STATUS_SECRET_FILE:-}" ]; then
  echo "Error: WORLDID_STATUS_SECRET_FILE environment variable not set" >&2
  exit 2
fi

# Check secret file exists
if [ ! -f "$WORLDID_STATUS_SECRET_FILE" ]; then
  echo "Error: Secret file not found: $WORLDID_STATUS_SECRET_FILE" >&2
  exit 2
fi

# Create temp file for response
RESPONSE_FILE=$(mktemp)
trap "rm -f '$RESPONSE_FILE'" EXIT

# Read secret from file and query the status socket
# Capture curl exit code explicitly (under set -euo pipefail, errors would kill the script)
CURL_EXIT=0
HTTP_CODE=$(printf "Authorization: Bearer %s" "$(cat "$WORLDID_STATUS_SECRET_FILE")" | \
  curl --silent --show-error \
  --unix-socket "$WORLDID_STATUS_SOCKET" \
  --header @- \
  --write-out "\n%{http_code}" \
  --output "$RESPONSE_FILE" \
  "http://localhost/status/$USER_ID" 2>&1 | tail -1) || CURL_EXIT=$?

# Check if curl failed (connection error / missing socket)
if [ "$CURL_EXIT" -ne 0 ]; then
  echo "Error: Cannot connect to socket (is the gate service running?)" >&2
  exit 3
fi

# Check if HTTP_CODE is numeric
if [ -z "$HTTP_CODE" ] || ! [[ "$HTTP_CODE" =~ ^[0-9]+$ ]]; then
  echo "Error: Invalid response from socket" >&2
  exit 3
fi

# Check HTTP status
case "$HTTP_CODE" in
  200)
    cat "$RESPONSE_FILE"
    exit 0
    ;;
  401)
    echo "Error: Authentication failed (invalid bearer token)" >&2
    exit 2
    ;;
  404)
    echo "Error: Endpoint not found (check socket path)" >&2
    exit 3
    ;;
  429)
    echo "Error: Rate limit exceeded" >&2
    exit 4
    ;;
  *)
    echo "Error: Unexpected HTTP status $HTTP_CODE" >&2
    cat "$RESPONSE_FILE" >&2
    exit 3
    ;;
esac
